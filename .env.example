# Auth back office
ADMIN_PASSWORD=barbara-demo
AUTH_SECRET=change-me-in-production

# SQLite local (default). For Neon later, migrate schema to Postgres.
DATABASE_PATH=data/elbarbara.db

# Demo mode stays on unless you set DEMO_MODE=false
DEMO_MODE=true

# WhatsApp Cloud API (Meta) — leave empty to stay in demo mode
# See docs/meta-setup.md when you have your own test number/token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=el-barbara-verify
# Optional: enables X-Hub-Signature-256 checks on the webhook
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Google Sheets mirror (optional)
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=