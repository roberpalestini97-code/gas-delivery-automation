# Auth back office
ADMIN_PASSWORD=barbara-demo
AUTH_SECRET=el-barba-gas-dev-secret

# SQLite local. On Vercel, /tmp is used automatically.
DATABASE_PATH=data/elbarbara.db

# true until Meta credentials are set
DEMO_MODE=true

# WhatsApp Cloud API — leave empty for demo mode
# docs/meta-setup.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=el-barbara-verify
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Google Sheets mirror (optional)
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
